rules_version = '2';

// 這組規則負責「伺服器端」的資料驗證（前端的檢查可被繞過，這裡才是真正把關的地方）。
// 部署方式：Firebase Console > Firestore Database > 規則，貼上並發布；
// 或使用 CLI：firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /threads/{threadId} {
      // 討論串公開可讀，任何人都能瀏覽
      allow read: if true;

      // 僅允許已登入（含匿名登入）的使用者發文，且欄位需通過驗證
      allow create: if request.auth != null && isValidThread(request.resource.data);

      // 文章一律不可修改或刪除，保持討論串的完整與可信度
      allow update, delete: if false;
    }

    function isValidThread(data) {
      let keys = ['content', 'childAge', 'childGender', 'role', 'hashtags', 'author', 'createdAt'];
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.childAge is number && data.childAge >= 0 && data.childAge <= 12
        && data.childGender in ['男', '女', '不指定']
        && data.role in ['家長', '醫師', '護士', '醫檢師', '其他']
        && data.hashtags is list && data.hashtags.size() <= 5
        && data.author is string && data.author.size() <= 50
        && data.createdAt == request.time;
    }
  }
}
