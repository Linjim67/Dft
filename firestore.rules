rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {

    match /threads/{threadId} {

      allow read: if true;

      // 建立討論串：驗證必要欄位、型別與長度
      allow create: if request.auth != null
        && validThread(request.resource.data);

      // 更新：只允許互動統計欄位變動（點閱、停留、回覆數、最後活動時間），
      //       其餘內容欄位不得被竄改。
      allow update: if request.auth != null
        && onlyCounterFieldsChanged();

      allow delete: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 50;
        allow update, delete: if false;
      }
    }

    // ── 暫時代碼（#01 → 醫檢師） ─────────────────────────────────
    // codes/{代碼} 是代碼的「鎖」：誰拿著、狀態、期限，沒有個人資料，
    // 登入的人都能用代碼讀單一張（家長的手機要先讀，才知道這組有沒有人在用）；不能列出全部。
    // 同一組代碼在 expiresAt（領取後 24 小時）之前絕不會再發給別人；
    // 醫檢師送出回饋只會把它標成 done（失效、查不到），不會提早釋出。
    match /codes/{code} {
      allow get: if request.auth != null && code.matches('^[0-9]{4}$');
      allow list: if false;

      // 領取：全新的代碼，或上一位的 24 小時已經過了
      allow create: if validClaim(code, request.resource.data);
      allow update: if (resource.data.expiresAt < request.time && validClaim(code, request.resource.data))
        || staffFinish(code);
      allow delete: if false;

      // 給醫檢師看的個人資料（不含暱稱）。
      // 只能在領取代碼的同一筆交易裡寫入；只有醫檢師、而且代碼還有效時才讀得到；
      // 醫檢師送出回饋（代碼變 done）的同一批寫入裡刪除。
      match /private/{docId} {
        allow get: if docId == 'profile' && isStaff() && codeLive(code);
        allow list: if false;
        allow create, update: if docId == 'profile' && claimedNow(code)
          && validCodeProfile(request.resource.data, getAfter(lockPath(code)).data);
        allow delete: if docId == 'profile' && finishing(code);
      }
    }

    // 醫護人員登入：staff/{uid}。密碼不上傳，只上傳 PBKDF2 金鑰；
    // 這裡比對金鑰的 SHA-256。規則裡只有雜湊值，沒有密碼也沒有金鑰。
    match /staff/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && validStaffSession(request.resource.data);
    }

    // 醫檢師回饋：只能新增，任何人都不能讀、改、刪（和家長的回饋一樣）。
    // id = 代碼-領取時間（毫秒）：一次領取只會有一份；而且必須和「代碼變 done」同一批寫入。
    match /staffFeedback/{id} {
      allow create: if isStaff() && validStaffFeedback(id, request.resource.data);
      allow read, update, delete: if false;
    }

    function lockPath(code) {
      return /databases/$(database)/documents/codes/$(code);
    }

    function codeProfilePath(code) {
      return /databases/$(database)/documents/codes/$(code)/private/profile;
    }

    function isStaff() {
      let s = /databases/$(database)/documents/staff/$(request.auth.uid);
      return request.auth != null && exists(s) && get(s).data.expiresAt > request.time;
    }

    function codeLive(code) {
      let lock = get(lockPath(code)).data;
      return lock.status == 'active' && lock.expiresAt > request.time;
    }

    // 這一批寫入由醫檢師把代碼從 active 變成 done
    function finishing(code) {
      return isStaff() && codeLive(code) && getAfter(lockPath(code)).data.status == 'done';
    }

    // 這一筆交易剛由自己領取這組代碼（鎖的 createdAt 就是這次寫入的時間）
    function claimedNow(code) {
      let lock = getAfter(lockPath(code)).data;
      return request.auth != null && lock.holderUid == request.auth.uid
        && lock.createdAt == request.time;
    }

    function validClaim(code, d) {
      return request.auth != null
        && code.matches('^[0-9]{4}$')
        && d.keys().hasOnly(['v', 'code', 'holderUid', 'status', 'expiresAt', 'doneAt', 'createdAt'])
        && d.keys().hasAll(['v', 'code', 'holderUid', 'status', 'expiresAt', 'doneAt', 'createdAt'])
        && d.v == 1
        && d.code == code
        && d.holderUid == request.auth.uid
        && d.status == 'active'
        && d.doneAt == null
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt < request.time + duration.value(2, 'd')
        // 鎖和個人資料一定一起出現：醫檢師查得到代碼，就一定看得到資料
        && existsAfter(codeProfilePath(code));
    }

    // 醫檢師結束代碼：只改 status / doneAt，而且同一批寫入一定有這次領取的回饋
    function staffFinish(code) {
      let d = request.resource.data;
      return isStaff()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
        && d.status == 'done'
        && d.doneAt == request.time
        && existsAfter(/databases/$(database)/documents/staffFeedback/$(code + '-' + string(resource.data.createdAt.toMillis())));
    }

    function validStaffFeedback(id, d) {
      let code = id.split('-')[0];
      let lock = get(lockPath(code)).data;
      let prof = get(codeProfilePath(code)).data;
      return id.matches('^[0-9]{4}-[0-9]{1,16}$')
        && id == code + '-' + string(lock.createdAt.toMillis())
        && finishing(code)
        && d.keys().hasOnly(['staffFear', 'parentFear', 'note', 'profile', 'scaleVersion', 'createdAt'])
        && d.keys().hasAll(['staffFear', 'parentFear', 'note', 'profile', 'scaleVersion', 'createdAt'])
        && isLevel(d.staffFear)
        && d.parentFear == prof.fearLevel
        && d.note is string && d.note.size() <= 500
        && d.profile is map
        && d.profile.keys().hasOnly(['age', 'gender', 'worryLevel'])
        && d.profile.keys().hasAll(['age', 'gender', 'worryLevel'])
        && d.profile.age == prof.age
        && d.profile.gender == prof.gender
        && d.profile.worryLevel == prof.worryLevel
        && d.scaleVersion in ['staff-v1']
        && d.createdAt == request.time;
    }

    // 回饋（#03）：只能新增；任何人都不能讀、改、刪。
    // 畫圓圈・每日排行榜（#07）：每支手機（匿名 uid）每天一筆最高分，只有分數，不放名字。
    // 只能寫「今天」（台灣時間）、只能寫自己的、分數只能往上；誰都不能刪。
    match /circleDays/{day}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && isTaipeiToday(day)
        && validCircleScore(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && isTaipeiToday(day)
        && validCircleScore(request.resource.data)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // keys().hasOnly 是白名單：帶有 nickname（或任何多出來的欄位）的文件
    // 會在伺服器端直接被拒絕，不只是前端「沒送」而已。
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && validFeedback(request.resource.data);
      allow read, update, delete: if false;
    }

    // 雙機配對（#07）：房間 id = 個人資料的 4 位數暫時代碼
    // 家長的手機建立房間；孩子的手機掃 QR code 後把自己的 uid 寫進 childUid。
    // 房間只放遊戲需要的年齡，不放暱稱等個人資料（keys().hasOnly 白名單）。
    match /rooms/{code} {
      // 子集合（cmds、state）用：查房間文件看是不是家長／孩子
      // （要放在這裡面：外層的函式看不到 database 這個變數）
      function roomData() {
        return get(/databases/$(database)/documents/rooms/$(code)).data;
      }

      function roomParent() {
        return request.auth != null
          && roomData().parentUid == request.auth.uid
          && roomData().expiresAt > request.time;
      }

      function roomChild() {
        return request.auth != null
          && roomData().childUid == request.auth.uid
          && roomData().expiresAt > request.time;
      }

      function roomMember() {
        return request.auth != null
          && (roomData().parentUid == request.auth.uid
            || roomData().childUid == request.auth.uid);
      }

      // 孩子的手機要先讀到房間才能加入；只能用代碼讀單一房間，不能列出全部
      allow get: if request.auth != null && code.matches('^[0-9]{4}$');
      allow list: if false;

      allow create: if request.auth != null
        && validNewRoom(code, request.resource.data);

      allow update: if request.auth != null && (
           (resource.data.parentUid == request.auth.uid && parentEdit())
        || (resource.data.childUid == request.auth.uid && childEdit())
        || (resource.data.childUid == null && joinEdit())
        // 過期的房間（別的家庭昨天用過同一組代碼）可以被重新建立
        || (resource.data.expiresAt < request.time && validNewRoom(code, request.resource.data)));

      allow delete: if request.auth != null && resource.data.parentUid == request.auth.uid;

      // 家長 → 孩子：放角色、事件。只有家長能下指令，指令不能改
      match /cmds/{cmdId} {
        allow read: if roomMember();
        allow create: if roomParent() && validCmd(request.resource.data);
        allow update: if false;
        allow delete: if roomParent();
      }

      // 孩子 → 家長：棋盤、分數、時間。只有已加入的孩子手機能寫
      match /state/{stateId} {
        allow read: if roomMember();
        allow create, update: if stateId == 'child' && roomChild()
          && validState(request.resource.data);
        allow delete: if false;
      }
    }
  }

  function roomKeys() {
    return ['v', 'code', 'age', 'parentUid', 'childUid', 'mode', 'game', 'request', 'expiresAt', 'createdAt'];
  }

  function validNewRoom(code, d) {
    return code.matches('^[0-9]{4}$')
      && d.keys().hasOnly(roomKeys()) && d.keys().hasAll(roomKeys())
      && d.v == 1
      && d.code == code
      && d.age is number && d.age >= 0 && d.age <= 18
      && d.parentUid == request.auth.uid
      && d.childUid == null
      && d.mode in ['manual', 'auto']
      && d.game == null
      && d.request == null
      && d.expiresAt is timestamp
      && d.expiresAt > request.time
      && d.expiresAt < request.time + duration.value(2, 'd')
      && d.createdAt == request.time;
  }

  function validRequest(r, statuses) {
    return r is map
      && r.keys().hasOnly(['game', 'status', 'at']) && r.keys().hasAll(['game', 'status', 'at'])
      && r.game in ['whack-a-mole']
      && r.status in statuses
      && r.at == request.time;
  }

  // 家長：模式、答應／拒絕、換遊戲、解除配對（childUid 只能清掉，不能換成別人）
  function parentEdit() {
    let d = request.resource.data;
    return d.diff(resource.data).affectedKeys().hasOnly(['mode', 'game', 'request', 'childUid', 'age', 'expiresAt'])
      && d.mode in ['manual', 'auto']
      && (d.game == null || d.game in ['whack-a-mole'])
      && (d.childUid == resource.data.childUid || d.childUid == null)
      && (d.request == null || d.request == resource.data.request
        || validRequest(d.request, ['accepted', 'rejected']))
      && d.age is number && d.age >= 0 && d.age <= 18
      && d.expiresAt is timestamp && d.expiresAt < request.time + duration.value(2, 'd');
  }

  // 孩子：只能提出「想玩什麼」
  function childEdit() {
    let d = request.resource.data;
    return d.diff(resource.data).affectedKeys().hasOnly(['request'])
      && validRequest(d.request, ['pending'])
      && resource.data.expiresAt > request.time;
  }

  // 加入：沒人加入的房間，只能把 childUid 寫成自己
  function joinEdit() {
    let d = request.resource.data;
    return d.diff(resource.data).affectedKeys().hasOnly(['childUid'])
      && d.childUid == request.auth.uid
      && resource.data.parentUid != request.auth.uid
      && resource.data.expiresAt > request.time;
  }

  function validCmd(c) {
    return c.by == request.auth.uid
      && c.at == request.time
      && ((c.keys().hasOnly(['t', 'h', 'c', 'v', 'by', 'at']) && c.keys().hasAll(['t', 'h', 'c', 'v', 'by', 'at'])
          && c.t == 'place'
          && c.h is int && c.h >= 0 && c.h <= 5
          && c.c in ['tourniquet', 'swab', 'syringe', 'virus']
          && c.v in ['normal', 'silver', 'iron'])
        || (c.keys().hasOnly(['t', 'e', 'by', 'at']) && c.keys().hasAll(['t', 'e', 'by', 'at'])
          && c.t == 'event'
          && c.e in ['invasion', 'boss', 'quake', 'bubbles', 'double']));
  }

  function validState(s) {
    return s.keys().hasOnly(['v', 'view', 'running', 'round', 'time', 'score', 'mult', 'holes',
        'inv', 'boss', 'quake', 'bubbles', 'dbl', 'mode', 'teach', 'ack', 'at'])
      && s.v == 1
      && s.view in ['intro', 'play', 'quiz', 'summary']
      && s.running is bool
      && s.round is int && s.round >= 1 && s.round <= 999
      && s.time is int && s.time >= 0 && s.time <= 30
      && s.score is int && s.score >= 0
      && s.holes is list && s.holes.size() <= 6
      && s.mode in ['manual', 'auto']
      && (s.ack == null || (s.ack is map && s.ack.keys().hasOnly(['id', 'ok', 'why'])))
      && s.at == request.time;
  }

  function validThread(d) {
    return d.role in ['家長', '醫師', '護士', '醫檢師', '其他']
      && d.author is string && d.author.size() <= 50
      && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
      && d.members is list && d.members.size() >= 1 && d.members.size() <= 8
      && d.hashtags is list && d.hashtags.size() <= 5
      && d.clicks == 0 && d.replyCount == 0 && d.dwellMs == 0;
  }

  function isLevel(v) {
    return v is int && v >= 1 && v <= 5;
  }

  // 欄位必須與 Anxin.codes.buildProfile（shared/app.js）完全一致；不含暱稱
  function validCodeProfile(p, lock) {
    return p.keys().hasOnly(['age', 'gender', 'fearLevel', 'worryLevel', 'specialNeeds', 'expiresAt'])
      && p.keys().hasAll(['age', 'gender', 'fearLevel', 'worryLevel', 'specialNeeds', 'expiresAt'])
      && p.age is number && p.age >= 0 && p.age <= 18
      && p.gender in ['男', '女']
      && isLevel(p.fearLevel)
      && isLevel(p.worryLevel)
      && p.specialNeeds is string && p.specialNeeds.size() <= 200
      && p.expiresAt == lock.expiresAt;
  }

  // 醫護人員密碼（目前是 123456）。頁面算 key = PBKDF2-SHA256(密碼, 'anxin-staff-v1', 600000 次, 32 bytes) 的 hex，
  // 這裡存的是 SHA-256(key)。換密碼：跑下面這行，把輸出貼到下面的字串，再發布規則。
  //   node -e "const c=require('crypto');const k=c.pbkdf2Sync(process.argv[1],'anxin-staff-v1',600000,32,'sha256').toString('hex');console.log(c.createHash('sha256').update(k).digest('hex'))" '新密碼'
  // 注意：這個檔案在公開的 GitHub repo 上，雜湊值任何人都看得到。正式密碼請用夠長的通關句
  //（例如四、五個詞），PBKDF2 才擋得住離線暴力破解；6 位數字幾小時內就會被試出來。
  // 登入有效 12 小時（一個班）；pro/pro.js 的 SESSION_MS 要小於這裡的 13 小時上限。
  function validStaffSession(d) {
    return d.keys().hasOnly(['key', 'at', 'expiresAt'])
      && d.keys().hasAll(['key', 'at', 'expiresAt'])
      && d.key is string && d.key.size() == 64
      && hashing.sha256(d.key).toHexString().lower()
        == '13613b945d1a3b140f626cf76781144e54f6644ee850255b10e6677a1bc4968f'
      && d.at == request.time
      && d.expiresAt is timestamp
      && d.expiresAt > request.time
      && d.expiresAt < request.time + duration.value(13, 'h');
  }

  // 欄位必須與 Anxin.buildFeedbackPayload（shared/app.js）完全一致
  function validFeedback(d) {
    return d.keys().hasOnly(['satisfaction', 'satisfactionReason', 'cryLevel',
        'effectiveness', 'suggestion', 'profile', 'scaleVersion', 'createdAt'])
      && d.keys().hasAll(['satisfaction', 'satisfactionReason', 'cryLevel',
        'effectiveness', 'suggestion', 'profile', 'scaleVersion', 'createdAt'])
      && isLevel(d.satisfaction)
      && isLevel(d.cryLevel)
      && isLevel(d.effectiveness)
      && d.satisfactionReason is string && d.satisfactionReason.size() <= 500
      && d.suggestion is string && d.suggestion.size() <= 1000
      && d.scaleVersion in ['balanced-v1']
      && d.createdAt == request.time
      && validFeedbackProfile(d.profile);
  }

  // 個人資料：不含暱稱、不含暫時代碼
  function validFeedbackProfile(p) {
    return p is map
      && p.keys().hasOnly(['age', 'gender', 'fearLevel', 'worryLevel', 'specialNeeds'])
      && p.keys().hasAll(['age', 'gender', 'fearLevel', 'worryLevel', 'specialNeeds'])
      && p.age is number && p.age >= 0 && p.age <= 18
      && p.gender in ['男', '女']
      && isLevel(p.fearLevel)
      && isLevel(p.worryLevel)
      && p.specialNeeds is string && p.specialNeeds.size() <= 200;
  }

  // 台灣時間（UTC+8）的今天，YYYYMMDD
  function isTaipeiToday(day) {
    let t = request.time + duration.value(8, 'h');
    return day.matches('^[0-9]{8}$')
      && int(day) == t.year() * 10000 + t.month() * 100 + t.day();
  }

  function validCircleScore(d) {
    return d.keys().hasOnly(['score', 'at']) && d.keys().hasAll(['score', 'at'])
      && d.score is int && d.score >= 0 && d.score <= 100
      && d.at == request.time;
  }

  // 只有 clicks / dwellMs / replyCount / lastActivityAt 這幾個欄位可被更新
  function onlyCounterFieldsChanged() {
    return request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['clicks', 'dwellMs', 'replyCount', 'lastActivityAt']);
  }
}
